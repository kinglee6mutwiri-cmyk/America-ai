 
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>America AI Sitemap</title>
  <meta name="description" content="Simple decorated sitemap page with links only for America AI." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#06110d;
      --surface:rgba(10, 33, 24, 0.68);
      --surface-2:rgba(13, 48, 34, 0.78);
      --line:rgba(145, 255, 192, 0.2);
      --text:#ecfff4;
      --muted:#a9d8bd;
      --accent:#36e38a;
      --accent-2:#00c2ff;
      --accent-3:#ffd166;
      --shadow:0 20px 60px rgba(0,0,0,.45);
      --radius:22px;
      --max:1100px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      color:var(--text);
      font-family:"Space Grotesk", sans-serif;
      background:
        linear-gradient(rgba(2,8,6,.72), rgba(2,8,6,.82)),
        url("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1600&q=80") center/cover fixed no-repeat;
      min-height:100vh;
      overflow-x:hidden;
    }

    .bg-orb,
    .bg-grid{
      position:fixed;
      inset:0;
      pointer-events:none;
      z-index:0;
    }

    .bg-orb::before,
    .bg-orb::after{
      content:"";
      position:absolute;
      border-radius:50%;
      filter:blur(70px);
      opacity:.25;
    }

    .bg-orb::before{
      width:320px;
      height:320px;
      background:var(--accent);
      top:8%;
      left:-5%;
    }

    .bg-orb::after{
      width:280px;
      height:280px;
      background:#ff3d6e;
      bottom:8%;
      right:-4%;
    }

    .bg-grid{
      background-image:
        linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
      background-size:26px 26px;
      mask-image:linear-gradient(to bottom, rgba(0,0,0,.55), transparent 92%);
      opacity:.35;
    }

    .wrap{
      position:relative;
      z-index:1;
      width:min(calc(100% - 28px), var(--max));
      margin-inline:auto;
      padding:24px 0 48px;
    }

    .hero{
      padding:18px 0 20px;
      animation:fadeUp .8s ease both;
    }

    .hero-bar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:20px;
    }

    .badge{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding:10px 14px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.06);
      backdrop-filter:blur(14px);
      border-radius:999px;
      color:var(--muted);
      font-size:.92rem;
      box-shadow:var(--shadow);
    }

    .dot{
      width:10px;
      height:10px;
      border-radius:50%;
      background:linear-gradient(135deg, var(--accent), var(--accent-2));
      box-shadow:0 0 18px rgba(54,227,138,.8);
    }

    h1{
      margin:0;
      font-family:"Sora", sans-serif;
      font-weight:800;
      font-size:clamp(2.2rem, 6vw, 5rem);
      line-height:.95;
      letter-spacing:-.05em;
      max-width:10ch;
      text-wrap:balance;
    }

    .sub{
      margin:16px 0 0;
      max-width:52ch;
      color:var(--muted);
      font-size:clamp(.98rem, 2vw, 1.08rem);
      line-height:1.7;
    }

    .panel{
      margin-top:22px;
      padding:18px;
      border-radius:calc(var(--radius) + 6px);
      background:linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
      border:1px solid rgba(255,255,255,.1);
      backdrop-filter:blur(18px);
      box-shadow:var(--shadow);
      animation:fadeUp .9s ease .08s both;
    }

    .panel-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:16px;
      flex-wrap:wrap;
    }

    .panel-title{
      font-family:"Sora", sans-serif;
      font-size:1.05rem;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:#d9ffea;
    }

    .count{
      color:var(--muted);
      font-size:.9rem;
      padding:8px 12px;
      border-radius:999px;
      background:rgba(0,0,0,.18);
      border:1px solid rgba(255,255,255,.08);
    }

    .links{
      display:grid;
      grid-template-columns:1fr;
      gap:12px;
    }

    .link-item{
      position:relative;
      display:flex;
      align-items:center;
      gap:14px;
      text-decoration:none;
      color:var(--text);
      padding:16px 16px;
      border-radius:18px;
      background:
        linear-gradient(180deg, rgba(17,70,49,.85), rgba(10,45,32,.88));
      border:1px solid rgba(116, 255, 176, .14);
      box-shadow:0 10px 24px rgba(0,0,0,.22);
      overflow:hidden;
      transform:translateY(18px);
      opacity:0;
      animation:stagger .7s ease forwards;
    }

    .link-item:nth-child(2){animation-delay:.05s}
    .link-item:nth-child(3){animation-delay:.1s}
    .link-item:nth-child(4){animation-delay:.15s}
    .link-item:nth-child(5){animation-delay:.2s}
    .link-item:nth-child(6){animation-delay:.25s}
    .link-item:nth-child(7){animation-delay:.3s}
    .link-item:nth-child(8){animation-delay:.35s}
    .link-item:nth-child(9){animation-delay:.4s}
    .link-item:nth-child(10){animation-delay:.45s}
    .link-item:nth-child(11){animation-delay:.5s}
    .link-item:nth-child(12){animation-delay:.55s}
    .link-item:nth-child(13){animation-delay:.6s}
    .link-item:nth-child(14){animation-delay:.65s}
    .link-item:nth-child(15){animation-delay:.7s}
    .link-item:nth-child(16){animation-delay:.75s}
    .link-item:nth-child(17){animation-delay:.8s}
    .link-item:nth-child(18){animation-delay:.85s}

    .link-item::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(90deg, transparent, rgba(255,255,255,.07), transparent);
      transform:translateX(-120%);
      transition:transform .8s ease;
    }

    .link-item::after{
      content:"";
      position:absolute;
      inset:auto -60px -60px auto;
      width:150px;
      height:150px;
      border-radius:50%;
      background:radial-gradient(circle, rgba(54,227,138,.18), transparent 60%);
      pointer-events:none;
    }

    .link-item:hover::before{
      transform:translateX(120%);
    }

    .link-item:hover{
      transform:translateY(-4px) scale(1.01);
      border-color:rgba(116,255,176,.34);
      box-shadow:0 18px 36px rgba(0,0,0,.3), 0 0 0 1px rgba(54,227,138,.08) inset;
    }

    .link-item:active{
      transform:translateY(-1px) scale(.995);
    }

    .icon{
      flex:0 0 46px;
      width:46px;
      height:46px;
      display:grid;
      place-items:center;
      border-radius:14px;
      background:linear-gradient(135deg, rgba(54,227,138,.22), rgba(0,194,255,.18));
      border:1px solid rgba(255,255,255,.12);
      backdrop-filter:blur(12px);
    }

    .icon svg{
      width:22px;
      height:22px;
      fill:none;
      stroke:#eafff2;
      stroke-width:1.8;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .path{
      min-width:0;
      font-size:1rem;
      font-weight:500;
      line-height:1.45;
      word-break:break-word;
    }

    .path small{
      display:block;
      margin-top:4px;
      color:var(--muted);
      font-size:.84rem;
      opacity:.95;
    }

    .footer{
      margin-top:24px;
      padding:14px 6px 0;
      color:#cfe8d7;
      font-size:.88rem;
      text-align:center;
      animation:fadeUp 1s ease .2s both;
    }

    .reveal{
      opacity:0;
      transform:translateY(24px);
      transition:opacity .8s ease, transform .8s ease;
    }

    .reveal.show{
      opacity:1;
      transform:translateY(0);
    }

    @media (min-width: 760px){
      .wrap{padding:34px 0 64px}
      .panel{padding:24px}
      .links{
        grid-template-columns:1fr 1fr;
      }
    }

    @media (min-width: 1080px){
      .hero{
        display:grid;
        grid-template-columns:1.1fr .9fr;
        gap:28px;
        align-items:end;
      }
      .hero-copy{padding-top:18px}
      .hero-side{
        min-height:220px;
        border-radius:30px;
        border:1px solid rgba(255,255,255,.12);
        background:
          linear-gradient(135deg, rgba(54,227,138,.14), rgba(0,194,255,.08)),
          rgba(255,255,255,.04);
        backdrop-filter:blur(16px);
        box-shadow:var(--shadow);
        position:relative;
        overflow:hidden;
      }
      .hero-side::before,
      .hero-side::after{
        content:"";
        position:absolute;
        border-radius:50%;
      }
      .hero-side::before{
        width:220px;
        height:220px;
        background:radial-gradient(circle, rgba(54,227,138,.3), transparent 65%);
        top:-40px;
        right:-20px;
      }
      .hero-side::after{
        width:180px;
        height:180px;
        background:radial-gradient(circle, rgba(255,209,102,.22), transparent 65%);
        bottom:-30px;
        left:10%;
      }
    }

    @keyframes fadeUp{
      from{opacity:0; transform:translateY(28px)}
      to{opacity:1; transform:translateY(0)}
    }

    @keyframes stagger{
      from{opacity:0; transform:translateY(18px)}
      to{opacity:1; transform:translateY(0)}
    }
  </style>
</head>
